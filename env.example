# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings for local development with SQL Server
DB_ENGINE=sql_server.pyodbc
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=1433

# Amazon SP-API Configuration
LWA_APP_ID=your_lwa_app_id
LWA_CLIENT_SECRET=your_lwa_client_secret
SP_API_REFRESH_TOKEN=your_sp_api_refresh_token
SP_API_REGION=us-east-1
SP_API_MARKETPLACE_ID=your_marketplace_id

# AWS Credentials for Amazon SP-API
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SP_API_ROLE_ARN=your_sp_api_role_arn

# MercadoLibre Configuration
MERCADOLIBRE_URL=https://api.mercadolibre.com
MERCADOLIBRE_SECRET_KEY=your_mercadolibre_secret_key
MERCADOLIBRE_APP_ID=your_mercadolibre_app_id
MERCADOLIBRE_USER=your_mercadolibre_user
MERCADOLIBRE_SITE=MLM
MERCADOLIBRE_REDIRECT_URI=your_mercadolibre_redirect_uri

# Shopify Configuration
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_API_VERSION=2024-01 